<section id="free-search" class="free-search">
    <h3 id="h1-free-search" class="homeBigTitle"><strong>Volver a buscar</strong></h3>

    <form action="/buscar/" method="POST" class="clearfix infoblock" name="frmAnuDir" id="free-search-form">
        <div class="item-form">
            <label class="input-radio inline">
                <input type="radio" checked="checked" value="sale" id="free-search-operation-sale" name="operation">
                <span><span>Comprar<span></span>
            </label>
            <label class="input-radio inline">
                <input type="radio" value="rent" id="free-search-operation-rent" name="operation">
                <span><span>Alquilar<span></span>
            </label>
        </div>
        <div class="search-block">
            <select id="typology" name="typology" class="dropdown">
                <option selected="selected" value="home">Viviendas</option>
                <option value="newdevelopment">Obra nueva</option>
                <option value="office">Oficinas</option>
                <option value="warehouse">Locales o naves</option>
                <option value="transfer">Traspasos</option>
                <option value="garage">Garajes</option>
                <option value="building">Edificios</option>
                <option value="storageroom">Trasteros</option>
                <option value="land">Terrenos</option>
                <option value="room">Habitación</option>
            </select>
            <div class="form-item-block" layermobileonblurexclusion="on">
                <input id="campoBus" mobileonblur="on" autocomplete="off" type="text" placeholder="Escribe dónde buscas" name="freeText" data-validation="required" data-message-required="Obligatorio">
                <div class="container-result-list">
                    <span class="txt-comment">También puedes buscar por característica, teléfono...</span>
                    <div class="result-list"></div>
                </div>
            </div>

            <button id="btn-free-search" class="btn regular">Buscar</button>
        </div>
    </form>

    <!-- highlight searches -->
    
</section>

